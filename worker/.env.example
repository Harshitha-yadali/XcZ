# Copy this file to worker/.env and fill in the blanks, then run `npm run worker`.
# worker/.env is covered by .gitignore, so it never reaches the repository.

# Required. Supabase dashboard -> Project Settings -> API.
# The service role key bypasses row level security: it belongs on the worker
# machine and nowhere near the browser bundle.
SUPABASE_URL=https://rixmudvtbfkjpwjoefon.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. The same value as the CREDENTIALS_KEY secret on the edge functions.
# Without it the worker cannot decrypt a saved site login, so an application
# that needs one pauses and asks you rather than failing.
CREDENTIALS_KEY=

# Optional. Without it the worker asks you about every question a form raises,
# rather than answering the ones the resume already covers.
OPENROUTER_API_KEY=

# Optional. Defaults are the machine name plus pid, and 5000ms.
# WORKER_ID=
# POLL_MS=
