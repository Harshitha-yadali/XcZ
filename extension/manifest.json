{
  "manifest_version": 3,
  "name": "PrimoBoost Auto Apply Helper",
  "version": "1.2.0",
  "description": "Fills LinkedIn Easy Apply, Google Forms and your own LinkedIn profile when you ask. You check, then press Submit or Save.",
  "permissions": ["storage"],
  "action": { "default_title": "PrimoBoost", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://primoboostai.in/*", "https://www.primoboostai.in/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["site.js"]
    },
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["form.js"]
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["match.js", "profile.js", "linkedin.js"]
    }
  ]
}
